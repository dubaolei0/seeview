# 复制本文件为 .env 并填入真实 key（.env 已被 .gitignore，不会进仓库）

# ── TTS：阿里云 DashScope（CosyVoice，主驱动）──────────────────────────
# 获取地址：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# ── TTS：豆包（ByteDance，默认驱动）─────────────────────────────────────────────────────────
DOUBAO_APPID=
DOUBAO_TOKEN=
DOUBAO_CLUSTER=seed-tts-2.0
DOUBAO_VOICE=zh_male_taocheng_uranus_bigtts

# ── AI 流水线模型（Pipeline 1 备课 / Pipeline 2 讲稿）────────────────────
BEIKE_MODEL=sonnet
JIANGGAO_MODEL=sonnet
YAML_MODEL=claude-opus-4-8
