{
  "id" : "cuboid-aux-2019-national-ii-17",
  "name" : "长方体棱上点与空间辅助线 2019年全国II卷理科第17题",
  "category" : "立体几何",
  "parent" : null,
  "tags" : [ "长方体", "正方形底面", "棱上点", "空间几何", "辅助线", "虚线", "线面垂直", "二面角", "BE", "EC1" ],
  "desc" : "绘制长方体 ABCD-A1B1C1D1 的立体示意图，底面 ABCD 为正方形，点 E 位于指定棱上，并绘制 BE、EC1 等空间辅助线。长方体的可见棱使用实线，遮挡棱使用虚线；根据题图显示 E、B、C1 之间的辅助线以及相关顶点标签。",
  "whenNotToUse" : "正方体、棱柱、棱锥或其他非长方体结构；题干不包含长方体 ABCD-A1B1C1D1、棱上点 E 或 BE、EC1 等空间辅助结构时不适合使用本模板。",
  "params" : [ {
    "name" : "side",
    "type" : "number",
    "min" : 1.0,
    "max" : null,
    "options" : null,
    "default" : "4",
    "desc" : "长方体底面正方形 ABCD 的边长"
  }, {
    "name" : "height",
    "type" : "number",
    "min" : 1.0,
    "max" : null,
    "options" : null,
    "default" : "5",
    "desc" : "长方体高，即 AA1、BB1、CC1、DD1 的长度"
  }, {
    "name" : "epar",
    "type" : "number",
    "min" : 0.0,
    "max" : 1.0,
    "options" : null,
    "default" : "0.50",
    "desc" : "点 E 在 A1D1 上的位置参数，0 表示 A1，1 表示 D1"
  }, {
    "name" : "showverts",
    "type" : "bool",
    "min" : null,
    "max" : null,
    "options" : null,
    "default" : "true",
    "desc" : "是否显示长方体 8 个顶点标签 A、B、C、D、A1、B1、C1、D1"
  }, {
    "name" : "showpoints",
    "type" : "bool",
    "min" : null,
    "max" : null,
    "options" : null,
    "default" : "true",
    "desc" : "是否显示点 E 的实心标记和标签"
  }, {
    "name" : "showaux",
    "type" : "bool",
    "min" : null,
    "max" : null,
    "options" : null,
    "default" : "true",
    "desc" : "是否显示 BE、EC1 等空间辅助线"
  } ],
  "constraints" : [ ],
  "template" : "% 参数由系统自动注入；长方体：前后两个矩形错位，遮挡棱用虚线\n% 图形包含棱上点 E，以及空间辅助线 BE、EC1\n% 视觉归一化：把最长外接边缩放到 6 个坐标单位，线宽与虚线样式不缩放\n\n% ==========================================================\n% 长方体透视参数\n% ==========================================================\n\n% dx：后方矩形相对于前方矩形的水平错位\n% dy：后方矩形相对于前方矩形的竖直错位\n\n\\pgfmathsetmacro{\\dx}{0.42 * \\side}\n\\pgfmathsetmacro{\\dy}{0.34 * \\side}\n\n% 宽高比钳制：height 相对底宽过大时压缩绘图高度（仅视觉比例，不影响拓扑与 epar）\n\\pgfmathsetmacro{\\drawH}{min(\\height, 1.5 * \\side)}\n\n% 视觉归一化\n\\pgfmathsetmacro{\\figscale}{6 / max(\\side + \\dx, \\drawH + \\dy)}\n\n\n% ==========================================================\n% 开始绘图\n% ==========================================================\n\n\\begin{tikzpicture}[\n    scale=\\figscale,\n    every node/.style={\n        font=\\small,\n        fill=none,\n        inner sep=1.5pt\n    }\n]\n\n    % ======================================================\n    % 长方体八个顶点\n    % ======================================================\n\n    % 底面 ABCD\n    \\coordinate (A) at (0,0);\n    \\coordinate (B) at (\\side,0);\n    \\coordinate (C) at (\\side+\\dx,\\dy);\n    \\coordinate (D) at (\\dx,\\dy);\n\n    % 顶面 A1B1C1D1（用钳制后的绘图高度）\n    \\coordinate (A1) at (0,\\drawH);\n    \\coordinate (B1) at (\\side,\\drawH);\n    \\coordinate (C1) at (\\side+\\dx,\\drawH+\\dy);\n    \\coordinate (D1) at (\\dx,\\drawH+\\dy);\n\n\n    % ======================================================\n    % 点 E：位于 A1D1 上\n    % ======================================================\n\n    % epar = 0：A1\n    % epar = 1：D1\n\n    \\pgfmathsetmacro{\\Ex}{\\epar * \\dx}\n    \\pgfmathsetmacro{\\Ey}{\\drawH + \\epar * \\dy}\n\n    \\coordinate (E) at (\\Ex,\\Ey);\n\n\n    % ======================================================\n    % 长方体可见实线\n    % ======================================================\n\n    % 前表面 A-A1-B1-B\n    \\draw[thick]\n        (A) -- (A1) -- (B1) -- (B) -- cycle;\n\n    % 右侧面 B-C-C1-B1\n    \\draw[thick]\n        (B) -- (C) -- (C1) -- (B1);\n\n    % 顶面后侧 D1-C1\n    \\draw[thick]\n        (D1) -- (C1);\n\n    % 顶面左侧 A1-D1\n    \\draw[thick]\n        (A1) -- (D1);\n\n\n    % ======================================================\n    % 长方体被遮挡棱：虚线\n    % ======================================================\n\n    % 底面后侧 A-D-C\n    \\draw[dashed]\n        (A) -- (D) -- (C);\n\n    % 左后竖棱 D-D1\n    \\draw[dashed]\n        (D) -- (D1);\n\n\n    % ======================================================\n    % 空间辅助线\n    % ======================================================\n\n    \\ifnum\\showaux>0\n\n        % --------------------------------------------------\n        % B-E\n        % --------------------------------------------------\n\n        \\draw[dashed,thick]\n            (B) -- (E);\n\n        % --------------------------------------------------\n        % E-C1\n        % --------------------------------------------------\n\n        \\draw[thick]\n            (E) -- (C1);\n\n    \\fi\n\n\n    % ======================================================\n    % 顶点标签\n    % ======================================================\n\n    \\ifnum\\showverts>0\n\n        % A\n        \\node[below left=4pt]\n            at (A) {$A$};\n\n        % B\n        \\node[below left=4pt]\n            at (B) {$B$};\n\n        % C\n        \\node[below right=4pt]\n            at (C) {$C$};\n\n        % D\n        \\node[below=6pt]\n            at (D) {$D$};\n\n        % A1\n        \\node[left=6pt]\n            at (A1) {$A_1$};\n\n        % B1\n        \\node[below right=5pt]\n            at (B1) {$B_1$};\n\n        % C1\n        \\node[above right=4pt]\n            at (C1) {$C_1$};\n\n        % D1\n        \\node[above left=4pt]\n            at (D1) {$D_1$};\n\n    \\fi\n\n\n    % ======================================================\n    % 点 E\n    % ======================================================\n\n    \\ifnum\\showpoints>0\n\n        % E 实心点\n        \\fill\n            (E) circle [radius=0.8pt];\n\n        % E 标签\n        \\node[left=6pt]\n            at (E) {$E$};\n\n    \\fi\n\n\n% ==========================================================\n% 结束绘图\n% ==========================================================\n\n\\end{tikzpicture}"
}