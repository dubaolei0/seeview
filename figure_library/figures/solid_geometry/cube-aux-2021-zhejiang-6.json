{
  "id": "cube-aux-2021-zhejiang-6",
  "name": "正方体-2021年浙江卷 第6题（正方体 + 内部辅助线 + 棱上动点）",
  "category": "立体几何",
  "parent": null,
  "tags": [
    "正方体",
    "立方体",
    "空间几何体",
    "线框图",
    "虚线",
    "体积",
    "表面积",
    "顶点标签",
    "边中点"
  ],
  "desc": "正方体线框图模板：前后两个正方形错位连接，前面与可见棱用实线，遮挡棱用虚线；支持可选显示 8 个顶点标签（A、B、C、D、A_1、B_1、C_1、D_1）。辅助结构 A_1D、DB、D_1B、MN 及中点 M、N 默认不显示，只有题干明确涉及这些辅助线或 M、N 时才开启 showaux。重要：M、N 仅在题干真正需要它们参与求解或证明时才定义和显示；禁止在题干中定义 M、N 后却不参与所求/所证（如只问平面 A_1DB 与平面 BDD_1B_1 的夹角而不涉及 M、N）。",
  "whenNotToUse": "长方体、棱柱、棱台或需要严格按题干指定透视角度、旋转方向的空间几何图形，建议改用自由 TikZ。题干不涉及 M、N 或 A_1D、DB、D_1B、MN 辅助线的问题不应开启 showaux；禁止为凑模板功能而强行加入不参与所求/所证的冗余点线（如定义了 M、N 却只问平面夹角与 M、N 无关）。",
  "params": [
    {
      "name": "side",
      "type": "number",
      "min": 1.0,
      "max": null,
      "options": null,
      "default": "4",
      "desc": "正方体棱长"
    },
    {
      "name": "showverts",
      "type": "bool",
      "min": null,
      "max": null,
      "options": null,
      "default": "true",
      "desc": "是否标出 8 个顶点标签 A、B、C、D、A_1、B_1、C_1、D_1；题干必须使用该命名体系，不要写 E、F、G、H"
    },
    {
      "name": "showaux",
      "type": "bool",
      "min": null,
      "max": null,
      "options": null,
      "default": "false",
      "desc": "是否显示 A_1D、DB、D_1B、MN 及 M、N 辅助结构；只有题干明确涉及 M、N 或这些辅助线时才设为 true"
    },
    {
      "name": "showmidpts",
      "type": "bool",
      "min": null,
      "max": null,
      "options": null,
      "default": "true",
      "desc": "当 showaux 为 true 时，是否标出辅助结构中的中点 M、N；题干未涉及 M、N 时不要开启 showaux"
    }
  ],
  "constraints": [],
  "template": "% 参数由系统自动注入；正方体：前后两个正方形错位，遮挡棱用虚线\n% 视觉归一化：把最长外接边缩放到 6 个坐标单位，线宽与虚线样式不缩放\n\n% ==========================================================\n% 正方体透视参数\n% ==========================================================\n\n% dx：前后正方形的水平错位\n% dy：前后正方形的竖直错位\n%\n% 这里不把 dx 设置得过大，避免 A1-D 与 D-B\n% 在视觉上接近同一直线\n\n\\pgfmathsetmacro{\\dx}{0.36 * \\side}\n\\pgfmathsetmacro{\\dy}{0.30 * \\side}\n\n% 视觉归一化\n\\pgfmathsetmacro{\\figscale}{6 / max(\\side + \\dx, \\side + \\dy)}\n\n\n% ==========================================================\n% 开始绘图\n% ==========================================================\n\n\\begin{tikzpicture}[\n    scale=\\figscale,\n    every node/.style={\n        font=\\small,\n        fill=none,\n        inner sep=1.5pt\n    }\n]\n\n\n    % ======================================================\n    % 底面 ABCD\n    % ======================================================\n\n    \\coordinate (A) at (0,0);\n    \\coordinate (B) at (\\side,0);\n    \\coordinate (C) at (\\side+\\dx,\\dy);\n    \\coordinate (D) at (\\dx,\\dy);\n\n\n    % ======================================================\n    % 顶面 A1B1C1D1\n    % ======================================================\n\n    \\coordinate (A1) at (0,\\side);\n    \\coordinate (B1) at (\\side,\\side);\n    \\coordinate (C1) at (\\side+\\dx,\\side+\\dy);\n    \\coordinate (D1) at (\\dx,\\side+\\dy);\n\n\n    % ======================================================\n    % 正方体可见实线\n    % ======================================================\n\n    % ----------------------------------------------\n    % 前面 ABCD 的对应前侧\n    % ----------------------------------------------\n\n    \\draw[thick]\n        (A) -- (B) -- (B1) -- (A1) -- cycle;\n\n\n    % ----------------------------------------------\n    % 右侧面\n    % ----------------------------------------------\n\n    \\draw[thick]\n        (B) -- (C) -- (C1) -- (B1);\n\n\n    % ----------------------------------------------\n    % 顶面后边\n    % ----------------------------------------------\n\n    \\draw[thick]\n        (D1) -- (C1);\n\n\n    % ----------------------------------------------\n    % 顶面左边\n    % ----------------------------------------------\n\n    \\draw[thick]\n        (A1) -- (D1);\n\n\n    % ======================================================\n    % 正方体被遮挡棱：虚线\n    % ======================================================\n\n    % ----------------------------------------------\n    % 底面后侧\n    % ----------------------------------------------\n\n    \\draw[dashed]\n        (A) -- (D) -- (C);\n\n\n    % ----------------------------------------------\n    % 左后竖棱\n    % ----------------------------------------------\n\n    \\draw[dashed]\n        (D) -- (D1);\n\n\n    % ======================================================\n    % 顶点标签\n    % ======================================================\n\n    \\ifnum\\showverts>0\n\n        % ----------------------------------------------\n        % 底面\n        % ----------------------------------------------\n\n        \\node[below left=3pt]\n            at (A) {$A$};\n\n        \\node[below right=3pt]\n            at (B) {$B$};\n\n        \\node[right=3pt]\n            at (C) {$C$};\n\n        \\node[left=3pt]\n            at (D) {$D$};\n\n\n        % ----------------------------------------------\n        % 顶面\n        % ----------------------------------------------\n\n        \\node[above left=3pt]\n            at (A1) {$A_1$};\n\n        % B1 特殊处理：\n        % 向右上偏移，避免与 B1 附近的棱线重叠\n\t\t\\node[above=8pt] \n\t\t\tat (B1) {$B_1$};\n\n        \\node[above right=3pt]\n            at (C1) {$C_1$};\n\n        \\node[above left=3pt]\n            at (D1) {$D_1$};\n\n    \\fi\n\n\n    % ======================================================\n    % 空间辅助结构\n    %\n    % 只有题干明确涉及 A1D、DB、D1B、MN 或 M、N 时，\n    % 才通过 showaux 开启，避免普通正方体题目出现多余点线。\n    % ======================================================\n\n    \\ifnum\\showaux>0\n\n        % ----------------------------------------------\n        % A1-D\n        %\n        % M 将严格位于该线段中点\n        % ----------------------------------------------\n\n        \\draw[dashed]\n            (A1) -- (D);\n\n\n        % ----------------------------------------------\n        % D-B\n        % ----------------------------------------------\n\n        \\draw[dashed]\n            (D) -- (B);\n\n\n        % ----------------------------------------------\n        % D1-B\n        %\n        % N 将严格位于该线段中点\n        % ----------------------------------------------\n\n        \\draw[dashed]\n            (D1) -- (B);\n\n\n        % ======================================================\n        % M：A1D 的中点\n        % ======================================================\n\n        % A1 = (0, side)\n        % D  = (dx, dy)\n        %\n        % M = ((0+dx)/2, (side+dy)/2)\n\n        \\pgfmathsetmacro{\\Mx}{0.5 * \\dx}\n        \\pgfmathsetmacro{\\My}{0.5 * (\\side + \\dy)}\n\n        \\coordinate (M) at (\\Mx,\\My);\n\n\n        % ======================================================\n        % N：D1B 的中点\n        % ======================================================\n\n        % D1 = (dx, side+dy)\n        % B  = (side, 0)\n        %\n        % N = ((dx+side)/2, (side+dy)/2)\n\n        \\pgfmathsetmacro{\\Nx}{0.5 * (\\side + \\dx)}\n        \\pgfmathsetmacro{\\Ny}{0.5 * (\\side + \\dy)}\n\n        \\coordinate (N) at (\\Nx,\\Ny);\n\n\n        % ======================================================\n        % MN：连接两个中点\n        % ======================================================\n\n        \\draw[dashed,thick]\n            (M) -- (N);\n\n\n        % ======================================================\n        % M、N 点及标签\n        % ======================================================\n\n        \\ifnum\\showmidpts>0\n\n            % ----------------------------------------------\n            % M、N 实心点\n            % ----------------------------------------------\n\n            \\fill\n                (M) circle [radius=1.6pt];\n\n            \\fill\n                (N) circle [radius=1.6pt];\n\n\n            % ----------------------------------------------\n            % M 标签\n            % ----------------------------------------------\n\n            \\node[left=5pt]\n                at (M) {$M$};\n\n\n            % ----------------------------------------------\n            % N 标签\n            % ----------------------------------------------\n\n            \\node[right=5pt,above=2pt]\n                at (N) {$N$};\n\n        \\fi\n\n    \\fi\n\n% ==========================================================\n% 结束绘图\n% ==========================================================\n\n\\end{tikzpicture}"
}
