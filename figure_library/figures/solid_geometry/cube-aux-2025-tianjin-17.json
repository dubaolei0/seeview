{
  "id": "cube-aux-2025-tianjin-17",
  "name": "正方体-2025年天津卷 第17题 空间辅助线-棱上点 EFG",
  "category": "立体几何-正方体/长方体",
  "parent": null,
  "tags": [
    "正方体",
    "立方体",
    "空间几何体",
    "线框图",
    "虚线",
    "空间辅助线",
    "棱上点",
    "顶点标签",
    "截面"
  ],
  "desc": "正方体空间几何线框图模板：前后两个正方形错位连接，前方正方形为 AA1B1B，后方正方形为 DD1C1C；可见棱使用实线，遮挡棱使用虚线；支持顶点标签，并支持在 A1D1、B1C1、C1C 上设置棱上点 E、F、G，同时绘制 EF、EG、EB、FB、FG 等空间辅助线。",
  "whenNotToUse": "长方体、棱柱、棱台、一般空间四边形或需要严格按照题干指定透视方向和旋转角度的立体图形，建议改用自由 TikZ。",
  "params": [
    {
      "name": "side",
      "type": "number",
      "min": 1.0,
      "max": null,
      "options": null,
      "default": "4",
      "desc": "正方体棱长"
    },
    {
      "name": "showverts",
      "type": "bool",
      "min": null,
      "max": null,
      "options": null,
      "default": "true",
      "desc": "是否显示正方体 8 个顶点标签 A、B、C、D、A1、B1、C1、D1"
    },
    {
      "name": "showmidpts",
      "type": "bool",
      "min": null,
      "max": null,
      "options": null,
      "default": "true",
      "desc": "是否显示棱上点 E、F、G 及其实心点"
    }
  ],
  "constraints": [],
  "template": "% 参数由系统自动注入；正方体：前后两个正方形错位，遮挡棱用虚线\n% 图形包含棱上点 E、F、G 以及空间辅助线\n% 视觉归一化：把最长外接边缩放到 6 个坐标单位，线宽与虚线样式不缩放\n\n% ==========================================================\n% 正方体透视参数\n% ==========================================================\n\n% dx：后方正方形相对于前方正方形的水平错位\n% dy：后方正方形相对于前方正方形的竖直错位\n%\n% 前方正方形：A-A1-B1-B\n% 后方正方形：D-D1-C1-C\n%\n% 后方正方形向右上方错位\n\n\\pgfmathsetmacro{\\dx}{0.42 * \\side}\n\\pgfmathsetmacro{\\dy}{0.34 * \\side}\n\n% 视觉归一化\n\\pgfmathsetmacro{\\figscale}{6 / max(\\side + \\dx, \\side + \\dy)}\n\n\n% ==========================================================\n% 棱上点参数\n% ==========================================================\n\n% ----------------------------------------------------------\n% E 位于 A1-D1 上\n% 0 表示 A1\n% 1 表示 D1\n% ----------------------------------------------------------\n\n\\pgfmathsetmacro{\\epar}{0.50}\n\n\n% ----------------------------------------------------------\n% F 位于 B1-C1 上\n% 0 表示 B1\n% 1 表示 C1\n% ----------------------------------------------------------\n\n\\pgfmathsetmacro{\\fpar}{0.50}\n\n\n% ----------------------------------------------------------\n% G 位于 C1-C 上\n% 0 表示 C1\n% 1 表示 C\n% ----------------------------------------------------------\n\n\\pgfmathsetmacro{\\gpar}{0.25}\n\n\n% ==========================================================\n% 开始绘图\n% ==========================================================\n\n\\begin{tikzpicture}[\n    scale=\\figscale,\n    every node/.style={\n        font=\\small,\n        fill=none,\n        inner sep=1.5pt\n    }\n]\n\n\n    % ======================================================\n    % 前方正方形 A-A1-B1-B\n    % ======================================================\n\n    \\coordinate (A)  at (0,0);\n    \\coordinate (B)  at (\\side,0);\n\n    \\coordinate (A1) at (0,\\side);\n    \\coordinate (B1) at (\\side,\\side);\n\n\n    % ======================================================\n    % 后方正方形 D-D1-C1-C\n    % ======================================================\n\n    \\coordinate (D)  at (\\dx,\\dy);\n    \\coordinate (C)  at (\\side+\\dx,\\dy);\n\n    \\coordinate (D1) at (\\dx,\\side+\\dy);\n    \\coordinate (C1) at (\\side+\\dx,\\side+\\dy);\n\n\n    % ======================================================\n    % 棱上点 E\n    % ======================================================\n\n    % E 位于 A1-D1 上\n    % E = A1 + epar * (D1-A1)\n\n    \\pgfmathsetmacro{\\Ex}{\\epar * \\dx}\n    \\pgfmathsetmacro{\\Ey}{\\side + \\epar * \\dy}\n\n    \\coordinate (E) at (\\Ex,\\Ey);\n\n\n    % ======================================================\n    % 棱上点 F\n    % ======================================================\n\n    % F 位于 B1-C1 上\n    % F = B1 + fpar * (C1-B1)\n\n    \\pgfmathsetmacro{\\Fx}{\\side + \\fpar * \\dx}\n    \\pgfmathsetmacro{\\Fy}{\\side + \\fpar * \\dy}\n\n    \\coordinate (F) at (\\Fx,\\Fy);\n\n\n    % ======================================================\n    % 棱上点 G\n    % ======================================================\n\n    % G 位于 C1-C 上\n    % G = C1 + gpar * (C-C1)\n\n    \\pgfmathsetmacro{\\Gx}{\\side + \\dx}\n    \\pgfmathsetmacro{\\Gy}{\\side + \\dy - \\gpar * \\side}\n\n    \\coordinate (G) at (\\Gx,\\Gy);\n\n\n    % ======================================================\n    % 正方体可见棱\n    % ======================================================\n\n    % ------------------------------------------------------\n    % 前方正方形\n    % A-A1-B1-B\n    % ------------------------------------------------------\n\n    \\draw[thick]\n        (A) -- (A1) -- (B1) -- (B) -- cycle;\n\n\n    % ------------------------------------------------------\n    % 后方左上棱\n    % A1-D1\n    % ------------------------------------------------------\n\n    \\draw[thick]\n        (A1) -- (D1);\n\n\n    % ------------------------------------------------------\n    % 后方上棱\n    % D1-C1\n    % ------------------------------------------------------\n\n    \\draw[thick]\n        (D1) -- (C1);\n\n\n    % ------------------------------------------------------\n    % 后方右竖棱\n    % C1-C\n    % ------------------------------------------------------\n\n    \\draw[thick]\n        (C1) -- (C);\n\n\n    % ------------------------------------------------------\n    % 右侧底棱\n    % B-C\n    % ------------------------------------------------------\n\n    \\draw[thick]\n        (B) -- (C);\n\n\n    % ======================================================\n    % 正方体被遮挡棱：虚线\n    % ======================================================\n\n    % ------------------------------------------------------\n    % A-D\n    % ------------------------------------------------------\n\n    \\draw[dashed]\n        (A) -- (D);\n\n\n    % ------------------------------------------------------\n    % D-D1\n    % ------------------------------------------------------\n\n    \\draw[dashed]\n        (D) -- (D1);\n\n\n    % ------------------------------------------------------\n    % D-C\n    % ------------------------------------------------------\n\n    \\draw[dashed]\n        (D) -- (C);\n\n\n    % ======================================================\n    % 空间辅助线\n    % ======================================================\n\n    % ------------------------------------------------------\n    % E-F\n    %\n    % 注意：EF 为实线\n    % ------------------------------------------------------\n\n    \\draw[thick]\n        (E) -- (F);\n\n\n    % ------------------------------------------------------\n    % E-G\n    %\n    % E 与 G 直接连接\n    % 整条为虚线\n    % ------------------------------------------------------\n\n    \\draw[dashed,thick]\n        (E) -- (G);\n\n\n    % ------------------------------------------------------\n    % E-B\n    %\n    % 空间辅助线\n    % ------------------------------------------------------\n\n    \\draw[dashed,thick]\n        (E) -- (B);\n\n\n    % ------------------------------------------------------\n    % B1-F\n    %\n    % F 位于 B1-C1 上\n    % ------------------------------------------------------\n\n    \\draw[thick]\n        (B1) -- (F);\n\n\n    % ------------------------------------------------------\n    % F-C1\n    %\n    % F 位于 B1-C1 上\n    % ------------------------------------------------------\n\n    \\draw[thick]\n        (F) -- (C1);\n\n\n    % ------------------------------------------------------\n    % F-G\n    %\n    % FG 为实线\n    % ------------------------------------------------------\n\n    \\draw[thick]\n        (F) -- (G);\n\n\n    % ------------------------------------------------------\n    % F-B\n    %\n    % 空间辅助线\n    % ------------------------------------------------------\n\n    \\draw[thick]\n        (F) -- (B);\n\n\n    % ======================================================\n    % 顶点标签\n    % ======================================================\n\n    \\ifnum\\showverts>0\n\n        % --------------------------------------------------\n        % A\n        % --------------------------------------------------\n\n        \\node[below left=4pt]\n            at (A) {$A$};\n\n\n        % --------------------------------------------------\n        % A1\n        % --------------------------------------------------\n\n        \\node[left=7pt]\n            at (A1) {$A_1$};\n\n\n        % --------------------------------------------------\n        % B1\n        %\n        % 明显向左偏移，避免压住 B1-C1、B1-F\n        % --------------------------------------------------\n\n\t\t\\node[below left=8pt]\n\t\t\tat (B1) {$B_1$};\n\n\n        % --------------------------------------------------\n        % B\n        % --------------------------------------------------\n\n        \\node[below left=5pt]\n            at (B) {$B$};\n\n\n        % --------------------------------------------------\n        % D\n        %\n        % 明显向左下方偏移，避免压住 A-D\n        % --------------------------------------------------\n\n\t\t\\node[below=10pt]\n\t\t\tat (D) {$D$};\n\n\n        % --------------------------------------------------\n        % D1\n        % --------------------------------------------------\n\n        \\node[above left=6pt]\n            at (D1) {$D_1$};\n\n\n        % --------------------------------------------------\n        % C1\n        % --------------------------------------------------\n\n        \\node[above right=6pt]\n            at (C1) {$C_1$};\n\n\n        % --------------------------------------------------\n        % C\n        % --------------------------------------------------\n\n        \\node[below right=6pt]\n            at (C) {$C$};\n\n    \\fi\n\n\n    % ======================================================\n    % E、F、G 实心点\n    % ======================================================\n\n    \\ifnum\\showmidpts>0\n\n        \\node[circle, fill=black, inner sep=1.2pt] at (E) {};\n\n        \\node[circle, fill=black, inner sep=1.2pt] at (F) {};\n\n        \\node[circle, fill=black, inner sep=1.2pt] at (G) {};\n\n    \\fi\n\n\n    % ======================================================\n    % E 标签\n    % ======================================================\n\n    \\node[above left=4pt]\n        at (E) {$E$};\n\n\n    % ======================================================\n    % F 标签\n    % ======================================================\n\n    \\node[above left=4pt]\n        at (F) {$F$};\n\n\n    % ======================================================\n    % G 标签\n    % ======================================================\n\n    \\node[right=5pt]\n        at (G) {$G$};\n\n\n% ==========================================================\n% 结束绘图\n% ==========================================================\n\n\\end{tikzpicture}"
}
