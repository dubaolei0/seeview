{
  "id" : "cube-aux-2021-tianjin-17",
  "name" : "正方体-2021年天津卷 第17题（正方体 + 空间辅助线 + 棱上点）",
  "category" : "立体几何",
  "parent" : null,
  "tags" : [ "正方体", "立方体", "空间几何体", "线框图", "虚线", "空间辅助线", "棱上点", "顶点标签", "截面" ],
  "desc" : "正方体空间几何线框图模板：采用前后两个正方形错位连接的透视方式，正方体可见棱使用实线、遮挡棱使用虚线；支持 8 个顶点标签，并支持在前侧底棱 BC 与右侧底棱 CD 上设置点 E、F，同时绘制 A1C1、A1E、EC1、D1F 等空间辅助线，适合正方体中的截面、空间线面关系、线段长度及几何证明类题目。",
  "whenNotToUse" : "长方体、棱柱、棱台、一般空间四边形或需要严格按照题干指定透视方向和旋转角度的立体图形，建议改用自由 TikZ。",
  "params" : [ {
    "name" : "side",
    "type" : "number",
    "min" : 1.0,
    "max" : null,
    "options" : null,
    "default" : "4",
    "desc" : "正方体棱长"
  }, {
    "name" : "showverts",
    "type" : "bool",
    "min" : null,
    "max" : null,
    "options" : null,
    "default" : "true",
    "desc" : "是否显示正方体 8 个顶点标签 A、B、C、D、A1、B1、C1、D1"
  }, {
    "name" : "showmidpts",
    "type" : "bool",
    "min" : null,
    "max" : null,
    "options" : null,
    "default" : "true",
    "desc" : "是否显示棱上点 E、F 及其黑色实心点"
  } ],
  "constraints" : [ ],
  "template" : "% 参数由系统自动注入；正方体：前后两个正方形错位，遮挡棱用虚线\n% 图形包含棱上点 E、F 以及空间辅助线\n% 视觉归一化：把最长外接边缩放到 6 个坐标单位，线宽与虚线样式不缩放\n\n% ==========================================================\n% 正方体透视参数\n% ==========================================================\n\n\\pgfmathsetmacro{\\dx}{0.42 * \\side}\n\\pgfmathsetmacro{\\dy}{0.30 * \\side}\n\n% 视觉归一化\n\\pgfmathsetmacro{\\figscale}{6 / max(\\side + \\dx, \\side + \\dy)}\n\n\n% ==========================================================\n% 棱上点参数\n% ==========================================================\n\n% E 位于 BC 上\n% 0 表示 B，1 表示 C\n\\pgfmathsetmacro{\\epar}{0.55}\n\n% F 位于 CD 上\n% 0 表示 C，1 表示 D\n\\pgfmathsetmacro{\\fpar}{0.55}\n\n\n% ==========================================================\n% 开始绘图\n% ==========================================================\n\n\\begin{tikzpicture}[\n    scale=\\figscale,\n    every node/.style={\n        font=\\small,\n        fill=none,\n        inner sep=1.5pt\n    }\n]\n\n    % ======================================================\n    % 正方体八个顶点\n    % ======================================================\n\n    % 前方底面 B-C\n    \\coordinate (B) at (0,0);\n    \\coordinate (C) at (\\side,0);\n\n    % 后方底面 A-D\n    \\coordinate (A) at (\\dx,\\dy);\n    \\coordinate (D) at (\\side+\\dx,\\dy);\n\n    % 前方顶面 B1-C1\n    \\coordinate (B1) at (0,\\side);\n    \\coordinate (C1) at (\\side,\\side);\n\n    % 后方顶面 A1-D1\n    \\coordinate (A1) at (\\dx,\\side+\\dy);\n    \\coordinate (D1) at (\\side+\\dx,\\side+\\dy);\n\n\n    % ======================================================\n    % 棱上点 E\n    % ======================================================\n\n    % E = B + epar * (C-B)\n\n    \\pgfmathsetmacro{\\Ex}{\\epar * \\side}\n    \\pgfmathsetmacro{\\Ey}{0}\n\n    \\coordinate (E) at (\\Ex,\\Ey);\n\n\n    % ======================================================\n    % 棱上点 F\n    % ======================================================\n\n    % F = C + fpar * (D-C)\n\n    \\pgfmathsetmacro{\\Fx}{\\side + \\fpar * \\dx}\n    \\pgfmathsetmacro{\\Fy}{\\fpar * \\dy}\n\n    \\coordinate (F) at (\\Fx,\\Fy);\n\n\n    % ======================================================\n    % 正方体可见棱\n    % ======================================================\n\n    % 前表面 B-C-C1-B1\n    \\draw[thick]\n        (B) -- (C) -- (C1) -- (B1) -- cycle;\n\n    % B1-A1\n    \\draw[thick]\n        (B1) -- (A1);\n\n    % A1-D1\n    \\draw[thick]\n        (A1) -- (D1);\n\n    % D-D1\n    \\draw[thick]\n        (D) -- (D1);\n\n    % C-D\n    \\draw[thick]\n        (C) -- (D);\n\n    % C1-D1\n    \\draw[thick]\n        (C1) -- (D1);\n\n\n    % ======================================================\n    % 正方体隐藏棱\n    % ======================================================\n\n    % B-A\n    \\draw[dashed]\n        (B) -- (A);\n\n    % A-A1\n    \\draw[dashed]\n        (A) -- (A1);\n\n    % A-D\n    \\draw[dashed]\n        (A) -- (D);\n\n\n    % ======================================================\n    % 空间辅助线\n    % ======================================================\n\n    % ------------------------------------------------------\n    % B-A-D1\n    %\n    % 关键修改：\n    % B、A、D1 三点构成一条连续贯通的虚线。\n    % 不再单独绘制 B-D1，避免出现重复或多余虚线。\n    % ------------------------------------------------------\n\n    \\draw[dashed,thick]\n        (B) -- (A) -- (D1);\n\n\n    % ------------------------------------------------------\n    % A1-C1\n    %\n    % 顶面辅助对角线，实线\n    % ------------------------------------------------------\n\n    \\draw[thick]\n        (A1) -- (C1);\n\n\n    % ------------------------------------------------------\n    % A1-E\n    %\n    % 空间辅助线，虚线\n    % ------------------------------------------------------\n\n    \\draw[dashed,thick]\n        (A1) -- (E);\n\n    % ------------------------------------------------------\n    % E-C1\n    %\n    % 前侧面内部辅助线，实线\n    % ------------------------------------------------------\n\n    \\draw[thick]\n        (E) -- (C1);\n\n\n    % ------------------------------------------------------\n    % D1-F\n    %\n    % 右侧面内部辅助线，实线\n    % ------------------------------------------------------\n\n    \\draw[thick]\n        (D1) -- (F);\n\n\n    % ======================================================\n    % 顶点标签\n    % ======================================================\n\n    \\ifnum\\showverts>0\n\n        % --------------------------\n        % 底面\n        % --------------------------\n\n        \\node[below left=3pt]\n            at (B) {$B$};\n\n        \\node[below right=3pt]\n            at (C) {$C$};\n\n        \\node[left=5pt]\n            at (A) {$A$};\n\n        \\node[right=5pt]\n            at (D) {$D$};\n\n\n        % --------------------------\n        % 顶面\n        % --------------------------\n\n        \\node[above left=4pt]\n            at (A1) {$A_1$};\n\n        \\node[left=6pt]\n            at (B1) {$B_1$};\n\n        \\node[above left=5pt]\n            at (C1) {$C_1$};\n\n        \\node[above right=4pt]\n            at (D1) {$D_1$};\n\n    \\fi\n\n\n    % ======================================================\n    % E、F 点\n    % ======================================================\n\n    \\ifnum\\showmidpts>0\n\n        \\fill\n            (E) circle [radius=1.6pt];\n\n        \\fill\n            (F) circle [radius=1.6pt];\n\n    \\fi\n\n\n    % ======================================================\n    % E 标签\n    % ======================================================\n\n    \\node[below=4pt]\n        at (E) {$E$};\n\n\n    % ======================================================\n    % F 标签\n    % ======================================================\n\n    \\node[below right=4pt]\n        at (F) {$F$};\n\n\n% ==========================================================\n% 结束绘图\n% ==========================================================\n\n\\end{tikzpicture}"
}